# Local frontend settings, following bytewave-sites-gen2's .env.
# Fill these in as the new application's resources are created.
# Generated amplify_outputs.json supplies authentication and takes precedence
# over VITE_APP_API_GATEWAY. Never put secret keys in VITE_* variables.
VITE_APP_API_GATEWAY=
VITE_APP_BUSINESS_ID=
VITE_APP_PLATFORM_STATUS_URL=
VITE_APP_GOOGLE_ANALYTICS_ID=
VITE_APP_TURNSTILE_SITE_KEY=
VITE_APP_STRIPE_PUBLISHABLE_KEY=

# Application identity overrides and deployment setup: docs/DEPLOYMENT.md
